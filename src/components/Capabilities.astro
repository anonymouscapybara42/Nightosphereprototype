---
const caps = [
  { num: "01", title: "UI/UX Design", body: "Research-backed user experiences. We design journeys that reduce friction and drive action, from wireframes through final interactive prototypes." },
  { num: "02", title: "Graphic Design", body: "Visual communication built for brand impact — logos, illustrations, social graphics, and digital assets that maintain coherence across every touchpoint." },
  { num: "03", title: "Print & Brochure Design", body: "Professional print materials that represent your brand offline with the same quality as your digital presence. Sales decks, brochures, and marketing collateral." },
];
---
<section class="ns-caps" id="capabilities">
  <div class="ns-caps__inner">

    <div class="ns-caps__left ns-reveal-left">
      <span class="ns-eyebrow">Capabilities</span>
      <h2 class="ns-section-title">Launching Visions,<br /><span class="ns-grad">Building what you need.</span></h2>
      <p class="ns-section-desc" style="text-align:left;margin:0 0 2.5rem;">Our team covers the full spectrum of digital and creative services. When you work with Nightosphere, you work directly with the people doing the work.</p>

      <div class="ns-caps__trust">
        <div class="ns-trust-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          Dedicated point of contact
        </div>
        <div class="ns-trust-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          Transparent pricing, no hidden fees
        </div>
        <div class="ns-trust-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          Milestone-based delivery
        </div>
        <div class="ns-trust-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          Post-launch support included
        </div>
      </div>
    </div>

    <div class="ns-caps__right">
      {caps.map((c, i) => (
        <div class={`ns-cap-item ns-reveal ns-delay-${i + 1}`}>
          <span class="ns-cap-num">{c.num}</span>
          <div class="ns-cap-body">
            <h3>{c.title}</h3>
            <p>{c.body}</p>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<style>
.ns-caps {
  padding: 7rem 7%;
  background: var(--bg-page);
}
.ns-caps__inner {
  max-width: 1200px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 5rem;
  align-items: start;
}
.ns-caps__left { position: sticky; top: 100px; }

.ns-eyebrow {
  display: inline-block;
  font-size: 0.72rem;
  font-weight: 600;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--accent-2);
  margin-bottom: 1rem;
  padding: 0.28rem 0.85rem;
  background: rgba(0,212,255,0.07);
  border: 1px solid rgba(0,212,255,0.2);
  border-radius: 999px;
}
.ns-section-title {
  font-size: clamp(2rem, 4vw, 3rem);
  font-weight: 800;
  color: var(--text);
  margin-bottom: 1rem;
}
.ns-grad {
  background: linear-gradient(135deg, var(--accent), var(--accent-2));
  -webkit-background-clip: text;
  -webkit-text-fill-color: rgb(255, 255, 255);
  background-clip: text;
}
.ns-section-desc { font-size: 0.95rem; color: var(--muted); line-height: 1.8; }

.ns-caps__trust { display: flex; flex-direction: column; gap: .75rem; }
.ns-trust-item {
  display: flex; align-items: center; gap: .6rem;
  font-size: .875rem; color: var(--muted);
}
.ns-trust-item svg { color: var(--accent-2); flex-shrink: 0; }

.ns-caps__right { display: flex; flex-direction: column; gap: 0; }
.ns-cap-item {
  display: flex; gap: 1.5rem;
  padding: 2rem 0;
  border-bottom: 1px solid var(--border);
  transition: background .2s, padding-left .2s;
  cursor: default;
}
.ns-cap-item:first-child { padding-top: 0; }
.ns-cap-item:hover { padding-left: 0.5rem; }
.ns-cap-num {
  font-family: 'Syne', sans-serif;
  font-size: .75rem; font-weight: 700;
  color: var(--accent); opacity: .5;
  letter-spacing: .1em; padding-top: .2rem; min-width: 28px;
}
.ns-cap-body h3 { font-size: 1.1rem; font-weight: 700; color: var(--text); margin-bottom: .5rem; }
.ns-cap-body p  { font-size: .875rem; color: var(--muted); line-height: 1.8; }

@media (max-width: 900px) {
  .ns-caps__inner { grid-template-columns: 1fr; gap: 3rem; }
  .ns-caps__left  { position: static; }
  .ns-caps        { padding: 5rem 5%; }
}
</style>
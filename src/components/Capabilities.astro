---
const caps = [
  { num: "01", title: "UI/UX Design", body: "Research-backed user experiences. We design journeys that reduce friction and drive action, from wireframes through final interactive prototypes." },
  { num: "02", title: "Full-Stack Engineering", body: "Modern web stacks delivered with clean, maintainable code. We own both client and server side, ensuring seamless integration across the entire product." },
  { num: "03", title: "Graphic Design", body: "Visual communication built for brand impact — logos, illustrations, social graphics, and digital assets that maintain coherence across every touchpoint." },
  { num: "04", title: "Print & Brochure Design", body: "Professional print materials that represent your brand offline with the same quality as your digital presence. Sales decks, brochures, and marketing collateral." },
];
---
<section class="ns-caps" id="capabilities">
  <div class="ns-caps__inner">
    <div class="ns-caps__left">
      <span class="ns-eyebrow">Our Capabilities</span>
      <h2 class="ns-section-title">Everything in-house.<br /><span class="ns-grad">Nothing outsourced.</span></h2>
      <p class="ns-section-desc" style="text-align:left;margin:0 0 2.5rem;">Our team covers the full spectrum of digital and creative services. When you work with Nightosphere, you work directly with the people doing the work.</p>

      <div class="ns-caps__trust">
        <div class="ns-trust-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          Dedicated point of contact
        </div>
        <div class="ns-trust-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          Transparent pricing, no hidden fees
        </div>
        <div class="ns-trust-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          Milestone-based delivery
        </div>
        <div class="ns-trust-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          Post-launch support included
        </div>
      </div>
    </div>

    <div class="ns-caps__right">
      {caps.map((c) => (
        <div class="ns-cap-item">
          <span class="ns-cap-num">{c.num}</span>
          <div class="ns-cap-body">
            <h3>{c.title}</h3>
            <p>{c.body}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
.ns-caps {
  padding: 7rem 7%;
  background: var(--navy);
}
.ns-caps__inner {
  max-width: 1200px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 5rem;
  align-items: start;
}
.ns-caps__left { position: sticky; top: 100px; }

.ns-caps__trust { display: flex; flex-direction: column; gap: .75rem; }
.ns-trust-item {
  display: flex;
  align-items: center;
  gap: .6rem;
  font-size: .875rem;
  color: var(--muted);
}
.ns-trust-item svg { color: var(--accent-2); flex-shrink: 0; }

.ns-caps__right {
  display: flex;
  flex-direction: column;
  gap: 0;
}
.ns-cap-item {
  display: flex;
  gap: 1.5rem;
  padding: 2rem 0;
  border-bottom: 1px solid var(--border);
  transition: background .2s;
}
.ns-cap-item:first-child { padding-top: 0; }
.ns-cap-num {
  font-family: 'Syne', sans-serif;
  font-size: .75rem;
  font-weight: 700;
  color: var(--accent);
  opacity: .5;
  letter-spacing: .1em;
  padding-top: .2rem;
  min-width: 28px;
}
.ns-cap-body h3 {
  font-size: 1.1rem;
  font-weight: 700;
  color: var(--text);
  margin-bottom: .5rem;
}
.ns-cap-body p {
  font-size: .875rem;
  color: var(--muted);
  line-height: 1.8;
}

@media (max-width: 900px) {
  .ns-caps__inner { grid-template-columns: 1fr; gap: 3rem; }
  .ns-caps__left { position: static; }
  .ns-caps { padding: 5rem 5%; }
}
</style>
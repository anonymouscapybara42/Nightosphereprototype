---
const projects = [
  {
    title: "Nightosphere Web Services",
    description: "A full-service web development studio offering design, development, and hosting for modern businesses.",
    tags: ["Astro", "Tailwind", "TypeScript"],
    link: "#",
  },
  {
    title: "Portfolio & Photography",
    description: "Personal portfolio combining software engineering and photographic storytelling in a single cohesive experience.",
    tags: ["Web Design", "Photography", "Branding"],
    link: "#",
  },
  {
    title: "Engineering Projects",
    description: "Academic and personal computer engineering projects spanning embedded systems, algorithms, and software architecture.",
    tags: ["C++", "Python", "Systems"],
    link: "#",
  },
];
---

<section class="py-24 px-6" id="work">
  <div class="mx-auto max-w-3xl">
    <p class="text-xs uppercase tracking-widest text-green-400 font-semibold mb-2">Portfolio</p>
    <h2 class="mb-12 text-3xl font-bold text-white sm:text-4xl">Selected <span class="text-green-400">Work</span></h2>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {projects.map((project) => (
        <a
          href={project.link}
          class="group relative flex flex-col rounded-2xl border border-white/10 bg-white/5 p-6 hover:border-green-500/30 hover:bg-white/8 transition-all duration-300"
        >
          <div class="mb-3 h-1 w-8 rounded-full bg-green-500 group-hover:w-14 transition-all duration-300"></div>
          <h3 class="mb-2 font-semibold text-white group-hover:text-green-400 transition-colors">{project.title}</h3>
          <p class="mb-4 text-sm text-white/50 leading-relaxed flex-1">{project.description}</p>
          <div class="flex flex-wrap gap-2">
            {project.tags.map((tag) => (
              <span class="rounded-full bg-white/5 px-3 py-1 text-xs text-white/40">{tag}</span>
            ))}
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

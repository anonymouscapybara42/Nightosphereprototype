---
import { Image } from "astro:assets";
import img1 from "@/assets/1.jpg";
import img2 from "@/assets/2.jpg";
import img3 from "@/assets/3.jpg";
import img4 from "@/assets/4.jpg";
import img5 from "@/assets/5.jpg";
import img6 from "@/assets/6.jpg";

const slides = [img1, img2, img3, img4, img5, img6];
---

<section class="overflow-hidden py-10 sm:py-12" id="gallery">
  <div class="mx-auto mb-6 max-w-3xl px-6">
    <p class="mb-2 text-xs font-semibold tracking-widest text-green-400 uppercase">Gallery</p>
    <h2 class="text-2xl font-bold text-white">Through the Lens</h2>
  </div>

  <div class="relative mx-auto max-w-6xl px-6">
    <!-- Main Container -->
    <div class="relative overflow-hidden rounded-[2rem] border border-white/10 bg-slate-950/20 shadow-2xl">
      
      <!-- Nav Buttons -->
      <button
        id="prevBtn"
        class="absolute top-1/2 left-4 z-20 -translate-y-1/2 rounded-full border border-white/10 bg-black/50 p-4 text-white hover:bg-black/80 transition-all"
        aria-label="Previous slide"
      >
        ‹
      </button>

      <button
        id="nextBtn"
        class="absolute top-1/2 right-4 z-20 -translate-y-1/2 rounded-full border border-white/10 bg-black/50 p-4 text-white hover:bg-black/80 transition-all"
        aria-label="Next slide"
      >
        ›
      </button>

      <!-- Slides Wrapper -->
      <div 
        id="slideshow-wrapper" 
        class="flex transition-transform duration-700 ease-out w-full"
      >
        {
          slides.map((img, i) => (
            <div class="w-full shrink-0 flex-none aspect-video sm:h-[500px]">
              <Image
                src={img}
                alt={`Gallery image ${i + 1}`}
                class="h-full w-full object-cover"
              />
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  const wrapper = document.getElementById("slideshow-wrapper") as HTMLDivElement | null;
  const slides = wrapper?.children || [];
  const prevBtn = document.getElementById("prevBtn");
  const nextBtn = document.getElementById("nextBtn");

  let currentIndex = 0;
  let interval: number;

  function updateSlideshow() {
    if (wrapper) {
      wrapper.style.transform = `translateX(-${currentIndex * 100}%)`;
    }
  }

  function nextSlide() {
    currentIndex = (currentIndex + 1) % slides.length;
    updateSlideshow();
  }

  function prevSlide() {
    currentIndex = (currentIndex - 1 + slides.length) % slides.length;
    updateSlideshow();
  }

  // Set interval to 25 seconds (25000ms)
  function startTimer() {
    clearInterval(interval);
    interval = window.setInterval(nextSlide, 25000);
  }

  // Event Listeners
  nextBtn?.addEventListener("click", () => {
    nextSlide();
    startTimer(); // Reset timer on manual click
  });

  prevBtn?.addEventListener("click", () => {
    prevSlide();
    startTimer(); // Reset timer on manual click
  });

  // Initialize
  startTimer();
</script>
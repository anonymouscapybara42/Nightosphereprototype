---

---

<section class="ns-hero" id="home">
	<div class="ns-hero__bg">
		<div class="ns-hero__grid"></div>
		<div class="ns-hero__glow ns-hero__glow--1"></div>
		<div class="ns-hero__glow ns-hero__glow--2"></div>
	</div>

	<div class="ns-hero__content">

		<h1 class="ns-hero__title">
			Web Development & Design Studio<br />
			<span class="ns-hero__accent">built to last.</span>
		</h1>

		<p class="ns-hero__tagline">
			We make customer service our business<br class="ns-hero__br" />
			so you can focus on yours.
		</p>

		<p class="ns-hero__sub">
			Nightosphere delivers end-to-end web solutions — from strategy and design to development, SEO,
			and ongoing support.
		</p>

		<div class="ns-hero__ctas">
			<a href="/#contact" class="ns-btn ns-btn--lg">Start a Project</a>
			<a href="/#portfolio" class="ns-btn ns-btn--ghost">View Our Work</a>
		</div>

		<div class="ns-hero__stats">
			<div class="ns-stat">
				<span class="ns-stat__num">50+</span>
				<span class="ns-stat__label">Projects Delivered</span>
			</div>
			<div class="ns-stat__sep"></div>
			<div class="ns-stat">
				<span class="ns-stat__num">100%</span>
				<span class="ns-stat__label">In-House Team</span>
			</div>
			<div class="ns-stat__sep"></div>
			<div class="ns-stat">
				<span class="ns-stat__num">5★</span>
				<span class="ns-stat__label">Client Satisfaction</span>
			</div>
		</div>
	</div>

	<div class="ns-hero__visual" aria-hidden="true">
		<div class="ns-hero__card ns-hero__card--main">
			<div class="ns-card-header">
				<div class="ns-card-dots">
					<span></span><span></span><span></span>
				</div>
				<span class="ns-card-label">nightosphere.app</span>
			</div>
			<div class="ns-card-body">
				<div class="ns-card-line ns-card-line--title"></div>
				<div class="ns-card-line ns-card-line--sub"></div>
				<div class="ns-card-blocks">
					<div class="ns-card-block ns-card-block--img"></div>
					<div class="ns-card-block ns-card-block--text">
						<div class="ns-card-line"></div>
						<div class="ns-card-line ns-card-line--short"></div>
						<div class="ns-card-line"></div>
					</div>
				</div>
				<div class="ns-card-pill">Launch ↗</div>
			</div>
		</div>

		<div class="ns-hero__card ns-hero__card--sm ns-hero__card--a">
			<div class="ns-mini-label">SEO Score</div>
			<div class="ns-mini-score">98</div>
			<div class="ns-mini-bar">
				<div class="ns-mini-fill" style="width:98%"></div>
			</div>
		</div>

		<div class="ns-hero__card ns-hero__card--sm ns-hero__card--b">
			<div class="ns-mini-label">Uptime</div>
			<div class="ns-mini-score">99.9<span>%</span></div>
			<div class="ns-mini-bar">
				<div class="ns-mini-fill" style="width:99.9%;background:var(--accent-2)"></div>
			</div>
		</div>
	</div>
</section>

<style>
	.ns-hero {
		min-height: 100vh;
		display: grid;
		grid-template-columns: 1fr 1fr;
		align-items: center;
		gap: 4rem;
		padding: 8rem 7% 5rem;
		position: relative;
		overflow: hidden;
	}
	.ns-hero__bg {
		position: absolute;
		inset: 0;
		pointer-events: none;
	}
	.ns-hero__grid {
		position: absolute;
		inset: 0;
		background-image:
			linear-gradient(rgba(59, 126, 255, 0.06) 1px, transparent 1px),
			linear-gradient(90deg, rgba(59, 126, 255, 0.06) 1px, transparent 1px);
		background-size: 60px 60px;
		mask-image: radial-gradient(ellipse 80% 80% at 50% 20%, black 40%, transparent 100%);
	}
	.ns-hero__glow {
		position: absolute;
		border-radius: 50%;
		filter: blur(80px);
		opacity: 0.35;
	}
	.ns-hero__glow--1 {
		width: 700px;
		height: 700px;
		background: radial-gradient(circle, #3b7eff 0%, transparent 70%);
		top: -200px;
		right: -100px;
		animation: floatA 8s ease-in-out infinite;
	}
	.ns-hero__glow--2 {
		width: 400px;
		height: 400px;
		background: radial-gradient(circle, #00d4ff 0%, transparent 70%);
		bottom: -100px;
		left: 10%;
		opacity: 0.2;
		animation: floatB 10s ease-in-out infinite;
	}
	@keyframes floatA {
		0%,
		100% {
			transform: translate(0, 0);
		}
		50% {
			transform: translate(-30px, 30px);
		}
	}
	@keyframes floatB {
		0%,
		100% {
			transform: translate(0, 0);
		}
		50% {
			transform: translate(20px, -20px);
		}
	}

	@keyframes fadeInSlideUp {
		0% {
			opacity: 0;
			transform: translateY(30px);
		}
		100% {
			opacity: 1;
			transform: translateY(0);
		}
	}

	/* Badge */
	.ns-hero__badge {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.78rem;
		font-weight: 500;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--accent-2);
		background: rgba(0, 212, 255, 0.08);
		border: 1px solid rgba(0, 212, 255, 0.2);
		border-radius: 999px;
		padding: 0.35rem 0.9rem;
		margin-bottom: 1.5rem;
		animation: fadeInSlideUp 0.6s ease-out 0.1s both;
	}
	.ns-hero__dot {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: var(--accent-2);
		animation: pulse 2s ease-in-out infinite;
	}
	@keyframes pulse {
		0%,
		100% {
			opacity: 1;
			transform: scale(1);
		}
		50% {
			opacity: 0.5;
			transform: scale(1.3);
		}
	}

	/* Title */
	.ns-hero__title {
		font-size: clamp(2.8rem, 5vw, 4.5rem);
		font-weight: 800;
		color: var(--text);
		margin-bottom: 1rem;
		animation: fadeInSlideUp 0.6s ease-out 0.2s both;
	}
	.ns-hero__accent {
		background: linear-gradient(135deg, var(--accent), var(--accent-2));
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
	}

	/* Tagline */
	.ns-hero__tagline {
		font-family: "DM Sans", sans-serif;
		font-size: clamp(1rem, 1.5vw, 1.2rem);
		font-style: italic;
		font-weight: 300;
		color: var(--muted);
		border-left: 3px solid var(--accent);
		padding-left: 1rem;
		margin-bottom: 1.25rem;
		line-height: 1.6;
		animation: fadeInSlideUp 0.6s ease-out 0.3s both;
	}
	.ns-hero__sub {
		font-size: 0.95rem;
		color: var(--muted);
		max-width: 500px;
		margin-bottom: 2.25rem;
		line-height: 1.8;
		animation: fadeInSlideUp 0.6s ease-out 0.4s both;
	}

	/* CTAs */
	.ns-hero__ctas {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-bottom: 3rem;
		animation: fadeInSlideUp 0.6s ease-out 0.5s both;
	}
	.ns-btn {
		/* shared; extended below */
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-family: "Syne", sans-serif;
		font-weight: 600;
		border-radius: 8px;
		cursor: pointer;
		transition:
			background 0.2s,
			transform 0.15s,
			box-shadow 0.2s,
			color 0.2s;
		white-space: nowrap;
	}
	.ns-btn--lg {
		padding: 0.8rem 1.9rem;
		font-size: 1rem;
		background: var(--accent);
		color: #fff;
		border: 1.5px solid var(--accent);
	}
	.ns-btn--lg:hover {
		background: #2a6aee;
		transform: translateY(-2px);
		box-shadow: 0 12px 32px rgba(59, 126, 255, 0.4);
	}
	.ns-btn--ghost {
		padding: 0.8rem 1.9rem;
		font-size: 1rem;
		background: transparent;
		color: var(--text);
		border: 1.5px solid var(--border);
	}
	.ns-btn--ghost:hover {
		border-color: var(--accent);
		color: var(--accent);
		transform: translateY(-2px);
	}

	/* Stats */
	.ns-hero__stats {
		display: flex;
		align-items: center;
		gap: 1.5rem;
		animation: fadeInSlideUp 0.6s ease-out 0.6s both;
	}
	.ns-stat__num {
		display: block;
		font-family: "Syne", sans-serif;
		font-size: 1.7rem;
		font-weight: 800;
		color: var(--text);
	}
	.ns-stat__label {
		font-size: 0.75rem;
		color: var(--muted);
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}
	.ns-stat__sep {
		width: 1px;
		height: 36px;
		background: var(--border);
	}

	/* Visual side */
	.ns-hero__visual {
		position: relative;
		height: 480px;
		display: flex;
		align-items: center;
		justify-content: center;
		animation: fadeInSlideUp 0.8s ease-out 0.3s both;
	}
	.ns-hero__card {
		background: var(--glass);
		backdrop-filter: blur(12px);
		border: 1px solid var(--border);
		border-radius: 16px;
		overflow: hidden;
	}
	.ns-hero__card--main {
		width: 320px;
		animation: floatCard 6s ease-in-out infinite;
	}
	@keyframes floatCard {
		0%,
		100% {
			transform: translateY(0);
		}
		50% {
			transform: translateY(-12px);
		}
	}
	.ns-card-header {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		padding: 0.65rem 1rem;
		background: rgba(255, 255, 255, 0.04);
		border-bottom: 1px solid var(--border);
	}
	.ns-card-dots {
		display: flex;
		gap: 5px;
	}
	.ns-card-dots span {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: rgba(255, 255, 255, 0.12);
	}
	.ns-card-dots span:first-child {
		background: #ff5f57;
	}
	.ns-card-dots span:nth-child(2) {
		background: #febc2e;
	}
	.ns-card-dots span:last-child {
		background: #28c840;
	}
	.ns-card-label {
		font-size: 0.7rem;
		color: var(--muted);
		margin-left: 0.25rem;
	}
	.ns-card-body {
		padding: 1.2rem;
	}
	.ns-card-line {
		height: 10px;
		background: rgba(255, 255, 255, 0.08);
		border-radius: 999px;
		margin-bottom: 0.6rem;
	}
	.ns-card-line--title {
		width: 65%;
		height: 14px;
		background: rgba(59, 126, 255, 0.3);
	}
	.ns-card-line--sub {
		width: 45%;
	}
	.ns-card-line--short {
		width: 55%;
	}
	.ns-card-blocks {
		display: flex;
		gap: 0.8rem;
		margin: 1rem 0;
	}
	.ns-card-block--img {
		width: 80px;
		height: 60px;
		background: linear-gradient(135deg, rgba(59, 126, 255, 0.25), rgba(0, 212, 255, 0.15));
		border-radius: 8px;
		flex-shrink: 0;
	}
	.ns-card-block--text {
		flex: 1;
		padding-top: 0.25rem;
	}
	.ns-card-pill {
		display: inline-block;
		font-size: 0.72rem;
		font-weight: 600;
		color: var(--accent);
		background: rgba(59, 126, 255, 0.12);
		border: 1px solid rgba(59, 126, 255, 0.25);
		border-radius: 999px;
		padding: 0.25rem 0.75rem;
		margin-top: 0.5rem;
	}

	/* Small floating cards */
	.ns-hero__card--sm {
		position: absolute;
		padding: 1rem 1.25rem;
		min-width: 130px;
	}
	.ns-hero__card--a {
		top: 40px;
		left: -10px;
		animation: floatA2 7s ease-in-out infinite;
	}
	.ns-hero__card--b {
		bottom: 60px;
		right: -10px;
		animation: floatB2 9s ease-in-out infinite;
	}
	@keyframes floatA2 {
		0%,
		100% {
			transform: translate(0, 0) rotate(-2deg);
		}
		50% {
			transform: translate(6px, 8px) rotate(0deg);
		}
	}
	@keyframes floatB2 {
		0%,
		100% {
			transform: translate(0, 0) rotate(2deg);
		}
		50% {
			transform: translate(-6px, -6px) rotate(0deg);
		}
	}
	.ns-mini-label {
		font-size: 0.65rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--muted);
		margin-bottom: 0.3rem;
	}
	.ns-mini-score {
		font-family: "Syne", sans-serif;
		font-size: 1.8rem;
		font-weight: 800;
		color: var(--text);
		line-height: 1;
		margin-bottom: 0.4rem;
	}
	.ns-mini-score span {
		font-size: 1rem;
		color: var(--muted);
	}
	.ns-mini-bar {
		height: 4px;
		background: rgba(255, 255, 255, 0.08);
		border-radius: 2px;
		overflow: hidden;
	}
	.ns-mini-fill {
		height: 100%;
		background: var(--accent);
		border-radius: 2px;
	}

	.ns-hero__br {
		display: none;
	}

	@media (max-width: 900px) {
		.ns-hero {
			grid-template-columns: 1fr;
			padding: 7rem 5% 4rem;
			gap: 3rem;
			text-align: center;
		}
		.ns-hero__badge {
			margin-inline: auto;
		}
		.ns-hero__tagline {
			text-align: left;
		}
		.ns-hero__sub {
			margin-inline: auto;
		}
		.ns-hero__ctas {
			justify-content: center;
		}
		.ns-hero__stats {
			justify-content: center;
		}
		.ns-hero__visual {
			height: 300px;
		}
		.ns-hero__card--main {
			width: 260px;
		}
		.ns-hero__br {
			display: initial;
		}
	}
</style>

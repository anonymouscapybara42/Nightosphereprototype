---
export interface Props {
	title?: string;
	description?: string;
}
const {
	title = "Nightosphere — Information & Web Services",
	description = "Nightosphere is a full-service information and web development company delivering strategy, design, and technology for ambitious businesses.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content={description} />
		<title>{title}</title>
		<link rel="stylesheet" href="/global.css" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
	</head>
	<body>
		<!-- Particles canvas — sits behind everything -->
		<canvas id="ns-particles" aria-hidden="true"></canvas>
		<slot />
	</body>
</html>

<style>
	#ns-particles {
		position: fixed;
		inset: 0;
		z-index: 0;
		pointer-events: none;
		width: 100%;
		height: 100%;
	}

	/* Push all direct children of body above the canvas */
	body > :not(#ns-particles) {
		position: relative;
		z-index: 1;
	}
</style>

<script>
	(function () {
		const canvas = document.getElementById("ns-particles") as HTMLCanvasElement;
		const ctx = canvas.getContext("2d")!;

		// ── Config (tuned to match Nightosphere dark blue palette) ──
		const CONFIG = {
			count: 110,
			minRadius: 0.8,
			maxRadius: 2.2,
			speed: 0.28,
			linkDist: 130,
			linkOpacity: 0.18,
			colors: ["#3b7eff", "#00d4ff", "#7c9fff", "#ffffff"],
			bgColor: "transparent",
		};

		interface Particle {
			x: number;
			y: number;
			vx: number;
			vy: number;
			r: number;
			color: string;
			opacity: number;
		}

		let W = 0,
			H = 0;
		let particles: Particle[] = [];
		let raf: number;

		function resize() {
			W = canvas.width = window.innerWidth;
			H = canvas.height = window.innerHeight;
		}

		function randBetween(a: number, b: number) {
			return a + Math.random() * (b - a);
		}

		function createParticle(): Particle {
			const angle = Math.random() * Math.PI * 2;
			const speed = randBetween(0.05, CONFIG.speed);
			return {
				x: Math.random() * W,
				y: Math.random() * H,
				vx: Math.cos(angle) * speed,
				vy: Math.sin(angle) * speed,
				r: randBetween(CONFIG.minRadius, CONFIG.maxRadius),
				color: CONFIG.colors[Math.floor(Math.random() * CONFIG.colors.length)]!,
				opacity: randBetween(0.35, 0.85),
			};
		}

		function init() {
			resize();
			particles = Array.from({ length: CONFIG.count }, createParticle);
		}

		function hexToRgb(hex: string): string {
			const h = hex.replace("#", "");
			const bigint = parseInt(h, 16);
			const r = (bigint >> 16) & 255;
			const g = (bigint >> 8) & 255;
			const b = bigint & 255;
			return `${r},${g},${b}`;
		}

		// Pre-cache RGB strings
		const rgbCache: Record<string, string> = {};
		CONFIG.colors.forEach((c) => {
			rgbCache[c] = hexToRgb(c);
		});
		rgbCache["#ffffff"] = "255,255,255";

		function draw() {
			ctx.clearRect(0, 0, W, H);

			// Update + draw particles
			for (let i = 0; i < particles.length; i++) {
				const p = particles[i]!;
				p.x += p.vx;
				p.y += p.vy;

				// Wrap around edges
				if (p.x < -10) p.x = W + 10;
				else if (p.x > W + 10) p.x = -10;
				if (p.y < -10) p.y = H + 10;
				else if (p.y > H + 10) p.y = -10;

				// Draw dot
				ctx.beginPath();
				ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
				ctx.fillStyle = `rgba(${rgbCache[p.color] ?? "59,126,255"},${p.opacity})`;
				ctx.fill();
			}

			// Draw connecting lines
			for (let i = 0; i < particles.length; i++) {
				for (let j = i + 1; j < particles.length; j++) {
					const a = particles[i]!;
					const b = particles[j]!;
					const dx = a.x - b.x;
					const dy = a.y - b.y;
					const dist = Math.sqrt(dx * dx + dy * dy);
					if (dist < CONFIG.linkDist) {
						const alpha = CONFIG.linkOpacity * (1 - dist / CONFIG.linkDist);
						ctx.beginPath();
						ctx.moveTo(a!.x, a!.y);
						ctx.lineTo(b!.x, b!.y);
						ctx.strokeStyle = `rgba(59,126,255,${alpha})`;
						ctx.lineWidth = 0.6;
						ctx.stroke();
					}
				}
			}

			raf = requestAnimationFrame(draw);
		}

		// Mouse repulsion — subtle interactive touch
		let mouse = { x: -9999, y: -9999 };
		window.addEventListener("mousemove", (e) => {
			mouse.x = e.clientX;
			mouse.y = e.clientY;
		});
		window.addEventListener("mouseleave", () => {
			mouse.x = -9999;
			mouse.y = -9999;
		});

		// Re-size handler
		window.addEventListener("resize", () => {
			cancelAnimationFrame(raf);
			resize();
			draw();
		});

		// Kick off
		init();
		draw();
	})();
</script>

---
export interface Props {
	title?: string;
	description?: string;
}

const {
	title = "Nightosphere — Information & Web Services",
	description = "Nightosphere is a full-service information and web development company delivering strategy, design, and technology for ambitious businesses.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />

		<meta
			name="viewport"
			content="width=device-width, initial-scale=1.0"
		/>

		<meta name="description" content={description} />

		<title>{title}</title>

		<link rel="stylesheet" href="/global.css" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
	</head>

	<body>
		<!-- Background -->
		<div class="ns-bg"></div>

		<!-- Floating blue particles -->
		<div class="ns-squares" aria-hidden="true">
			<div class="ns-square"></div>
			<div class="ns-square"></div>
			<div class="ns-square"></div>
			<div class="ns-square"></div>
			<div class="ns-square"></div>
			<div class="ns-square"></div>
			<div class="ns-square"></div>
			<div class="ns-square"></div>
			<div class="ns-square"></div>
			<div class="ns-square"></div>
		</div>

		<!-- Canvas particles -->
		<canvas id="ns-particles" aria-hidden="true"></canvas>

		<slot />
	</body>
</html>

<style>
	/* ─────────────────────────────
	   GLOBAL BACKGROUND
	───────────────────────────── */

	html,
	body {
		background:
			radial-gradient(
				circle at top,
				rgba(24, 45, 95, 0.4),
				transparent 35%
			),
			radial-gradient(
				circle at bottom right,
				rgba(0, 120, 255, 0.15),
				transparent 30%
			),
			#050914;

		min-height: 100%;
	}

	body {
		position: relative;
		color: white;
		overflow-x: hidden;
	}

	/* ─────────────────────────────
	   DARK OVERLAY
	───────────────────────────── */

	.ns-bg {
		position: fixed;
		inset: 0;

		z-index: -3;

		background:
			linear-gradient(
				180deg,
				rgba(2, 5, 14, 0.15),
				rgba(2, 4, 12, 0.92)
			);

		pointer-events: none;
	}

	/* ─────────────────────────────
	   FLOATING BLUE SQUARES
	───────────────────────────── */

	.ns-squares {
		position: fixed;
		inset: 0;

		display: flex;
		justify-content: space-around;

		overflow: hidden;

		z-index: -2;
		pointer-events: none;
	}

	.ns-square {
		align-self: flex-end;

		width: 1em;
		height: 1em;

		background: rgba(59, 126, 255, 0.08);

		border: 1px solid rgba(0, 212, 255, 0.08);

		box-shadow:
			0 0 12px rgba(59, 126, 255, 0.12),
			0 0 28px rgba(0, 212, 255, 0.08);

		backdrop-filter: blur(2px);

		transform: translateY(100%) rotate(-50deg);

		animation: nsSquares 14s linear infinite;
	}

	.ns-square:nth-child(2) {
		width: 3em;
		height: 1.5em;

		animation-delay: 1s;
		animation-duration: 17s;

		filter: blur(5px);
	}

	.ns-square:nth-child(3) {
		width: 1em;
		height: 2em;

		animation-delay: 1.5s;
		animation-duration: 8s;
	}

	.ns-square:nth-child(4) {
		width: 1.5em;
		height: 1em;

		animation-delay: 0.5s;
		animation-duration: 13s;

		filter: blur(3px);
	}

	.ns-square:nth-child(5) {
		width: 2em;
		height: 1.25em;

		animation-delay: 4s;
		animation-duration: 11s;

		filter: blur(2px);
	}

	.ns-square:nth-child(6) {
		width: 2em;
		height: 2.5em;

		animation-delay: 2s;
		animation-duration: 9s;

		filter: blur(1px);
	}

	.ns-square:nth-child(7) {
		width: 2em;
		height: 5em;

		animation-duration: 12s;

		filter: blur(2.5px);
	}

	.ns-square:nth-child(8) {
		width: 3em;
		height: 1em;

		animation-delay: 5s;
		animation-duration: 18s;

		filter: blur(6px);
	}

	.ns-square:nth-child(9) {
		width: 2em;
		height: 1.5em;

		animation-duration: 9s;

		filter: blur(0.5px);
	}

	.ns-square:nth-child(10) {
		width: 2.4em;
		height: 3em;

		animation-delay: 6s;
		animation-duration: 12s;

		filter: blur(0.5px);
	}

	@keyframes nsSquares {
		from {
			transform: translateY(100vh) rotate(-50deg);
		}

		to {
			transform: translateY(-120vh) rotate(20deg);
		}
	}

	/* ─────────────────────────────
	   PARTICLE CANVAS
	───────────────────────────── */

	#ns-particles {
		position: fixed;
		inset: 0;

		width: 100%;
		height: 100%;

		z-index: -1;

		pointer-events: none;

		opacity: 0.95;
	}

	/* ─────────────────────────────
	   CONTENT LAYER
	───────────────────────────── */

	body > :not(#ns-particles):not(.ns-bg):not(.ns-squares) {
		position: relative;
		z-index: 1;
	}
</style>

<script>
	(function () {
		const canvas =
			document.getElementById(
				"ns-particles"
			) as HTMLCanvasElement;

		const ctx = canvas.getContext("2d")!;

		/* CONFIG */

		const CONFIG = {
			count: 115,

			minRadius: 0.8,
			maxRadius: 2.4,

			speed: 0.28,

			linkDist: 130,
			linkOpacity: 0.14,

			colors: [
				"#3b7eff",
				"#00d4ff",
				"#7c9fff",
				"#8ab4ff",
				"#4fc3ff",
			],
		};

		interface Particle {
			x: number;
			y: number;

			vx: number;
			vy: number;

			r: number;

			color: string;
			opacity: number;
		}

		let W = 0;
		let H = 0;

		let particles: Particle[] = [];

		let raf: number;

		function resize() {
			W = canvas.width = window.innerWidth;
			H = canvas.height = window.innerHeight;
		}

		function randBetween(a: number, b: number) {
			return a + Math.random() * (b - a);
		}

		function createParticle(): Particle {
			const angle = Math.random() * Math.PI * 2;

			const speed = randBetween(
				0.05,
				CONFIG.speed
			);

			return {
				x: Math.random() * W,
				y: Math.random() * H,

				vx: Math.cos(angle) * speed,
				vy: Math.sin(angle) * speed,

				r: randBetween(
					CONFIG.minRadius,
					CONFIG.maxRadius
				),

				color:
					CONFIG.colors[
						Math.floor(
							Math.random() *
								CONFIG.colors.length
						)
					]!,

				opacity: randBetween(0.25, 0.8),
			};
		}

		function init() {
			resize();

			particles = Array.from(
				{ length: CONFIG.count },
				createParticle
			);
		}

		function hexToRgb(hex: string): string {
			const h = hex.replace("#", "");

			const bigint = parseInt(h, 16);

			const r = (bigint >> 16) & 255;
			const g = (bigint >> 8) & 255;
			const b = bigint & 255;

			return `${r},${g},${b}`;
		}

		const rgbCache: Record<string, string> = {};

		CONFIG.colors.forEach((c) => {
			rgbCache[c] = hexToRgb(c);
		});

		function draw() {
			ctx.clearRect(0, 0, W, H);

			/* PARTICLES */

			for (let i = 0; i < particles.length; i++) {
				const p = particles[i]!;

				p.x += p.vx;
				p.y += p.vy;

				/* Wrap */

				if (p.x < -10) p.x = W + 10;
				else if (p.x > W + 10) p.x = -10;

				if (p.y < -10) p.y = H + 10;
				else if (p.y > H + 10) p.y = -10;

				ctx.beginPath();

				ctx.arc(
					p.x,
					p.y,
					p.r,
					0,
					Math.PI * 2
				);

				ctx.fillStyle = `rgba(${
					rgbCache[p.color] ??
					"59,126,255"
				},${p.opacity})`;

				ctx.fill();
			}

			/* CONNECTIONS */

			for (let i = 0; i < particles.length; i++) {
				for (
					let j = i + 1;
					j < particles.length;
					j++
				) {
					const a = particles[i]!;
					const b = particles[j]!;

					const dx = a.x - b.x;
					const dy = a.y - b.y;

					const dist = Math.sqrt(
						dx * dx + dy * dy
					);

					if (dist < CONFIG.linkDist) {
						const alpha =
							CONFIG.linkOpacity *
							(1 -
								dist /
									CONFIG.linkDist);

						ctx.beginPath();

						ctx.moveTo(a.x, a.y);
						ctx.lineTo(b.x, b.y);

						ctx.strokeStyle = `rgba(59,126,255,${alpha})`;

						ctx.lineWidth = 0.7;

						ctx.stroke();
					}
				}
			}

			raf = requestAnimationFrame(draw);
		}

		/* RESIZE */

		window.addEventListener("resize", () => {
			cancelAnimationFrame(raf);

			resize();
			draw();
		});

		/* INIT */

		init();
		draw();
	})();
</script>